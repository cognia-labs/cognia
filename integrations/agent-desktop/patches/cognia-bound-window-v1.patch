index 0000000..85a3e5a
--- /dev/null
+++ b/crates/macos/src/actions/bound_window_scope.rs
@@ -0,0 +1,122 @@
+use agent_desktop_core::{AdapterError, DeliverySemantics, RefEntry};
+use std::cell::RefCell;
+use std::marker::PhantomData;
+use std::rc::Rc;
+
+thread_local! {
+    static CURRENT: RefCell<Option<RefEntry>> = const { RefCell::new(None) };
+}
+
+pub(crate) struct BoundWindowScope {
+    previous: Option<RefEntry>,
+    _thread_affinity: PhantomData<Rc<()>>,
+}
+
+impl BoundWindowScope {
+    pub(crate) fn enter(entry: Option<&RefEntry>) -> Result<Self, AdapterError> {
+        if let Some(entry) = entry {
+            if entry
+                .source
+                .source_window_id
+                .as_deref()
+                .is_none_or(str::is_empty)
+                || entry
+                    .process
+                    .process_instance
+                    .as_deref()
+                    .is_none_or(str::is_empty)
+                || entry.source.source_surface != agent_desktop_core::SnapshotSurface::Window
+            {
+                return Err(refused("Ref action has no exact source-window identity"));
+            }
+        }
+        let previous = CURRENT.with(|current| {
+            let next = entry.cloned().or_else(|| current.borrow().clone());
+            current.replace(next)
+        });
+        Ok(Self {
+            previous,
+            _thread_affinity: PhantomData,
+        })
+    }
+}
+
+impl Drop for BoundWindowScope {
+    fn drop(&mut self) {
+        CURRENT.with(|current| {
+            current.replace(self.previous.take());
+        });
+    }
+}
+
+#[cfg(target_os = "macos")]
+pub(crate) fn validate(
+    element: &crate::tree::AXElement,
+    deadline: std::time::Instant,
+) -> Result<(), AdapterError> {
+    let Some(entry) = CURRENT.with(|current| current.borrow().clone()) else {
+        return Ok(());
+    };
+    let expected = entry
+        .source
+        .source_window_id
+        .as_deref()
+        .ok_or_else(|| refused("Source window is unavailable"))?;
+    let process = entry
+        .process
+        .process_instance
+        .as_deref()
+        .ok_or_else(|| refused("Source process generation is unavailable"))?;
+    let pid = crate::tree::properties::ax_ipc::pid(element, deadline)
+        .map_err(|_| refused("Target process identity is unreadable"))?;
+    if i32::try_from(entry.process.pid.get()).ok() != Some(pid)
+        || !crate::system::process::process_identity::matches_instance(pid, process)?
+    {
+        return Err(refused("Target process identity changed"));
+    }
+    let window =
+        match crate::tree::resolve::resolve_ax_read::read_string(element, "AXRole", deadline)? {
+            Some(role) if role == "AXWindow" => element.clone(),
+            _ => crate::tree::surface_read::element(element, "AXWindow", deadline)?
+                .ok_or_else(|| refused("Target owning window is unavailable"))?,
+        };
+    let actual = crate::system::window::window_bridge::window_id(&window, deadline)?;
+    verify_window(expected, actual)?;
+    crate::system::window::window_resolve::verify_window_identity_until(
+        expected,
+        crate::system::window::window_resolve::WindowIdentityEvidence {
+            pid,
+            app: None,
+            process_instance: Some(process),
+            title: None,
+            bounds_hash: None,
+        },
+        deadline,
+    )
+}
+
+fn verify_window(expected: &str, actual: Option<i64>) -> Result<(), AdapterError> {
+    if actual.is_none_or(|id| format!("w-{id}") != expected) {
+        return Err(refused("Target no longer belongs to its captured window"));
+    }
+    Ok(())
+}
+
+fn refused(message: &str) -> AdapterError {
+    AdapterError::stale_ref_because(message).with_disposition(DeliverySemantics::not_delivered())
+}
+
+pub(crate) fn allow_renderer_activation() -> Result<(), AdapterError> {
+    Err(
+        AdapterError::not_supported("Cognia forbids application-wide renderer activation")
+            .with_disposition(DeliverySemantics::not_delivered()),
+    )
+}
