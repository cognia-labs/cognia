+++ b/crates/macos/src/actions/bound_window_native_tests.rs
@@ -0,0 +1,120 @@
+use super::*;
+use crate::tree::{AXElement, properties::ax_ipc, surface_read};
+use core_foundation::{base::TCFType, string::CFString};
+use std::path::Path;
+use std::time::{Duration, Instant};
+
+fn state(directory: &Path) -> serde_json::Value {
+    serde_json::from_slice(&std::fs::read(directory.join("state.json")).unwrap()).unwrap()
+}
+
+fn command(directory: &Path, action: &str) {
+    let sequence = state(directory)["sequence"].as_u64().unwrap() + 1;
+    let temporary = directory.join("command.tmp");
+    std::fs::write(
+        &temporary,
+        serde_json::to_vec(&serde_json::json!({"sequence": sequence, "action": action})).unwrap(),
+    )
+    .unwrap();
+    std::fs::rename(temporary, directory.join("command.json")).unwrap();
+    let deadline = Instant::now() + Duration::from_secs(3);
+    while state(directory)["sequence"].as_u64() != Some(sequence) {
+        assert!(Instant::now() < deadline, "Fixture command timed out");
+        std::thread::sleep(Duration::from_millis(10));
+    }
+}
+
+fn find(element: &AXElement, identifier: &str, depth: usize) -> Option<AXElement> {
+    let deadline = Instant::now() + Duration::from_secs(3);
+    if surface_read::string(element, "AXIdentifier", deadline)
+        .ok()
+        .flatten()
+        .as_deref()
+        == Some(identifier)
+    {
+        return Some(element.clone());
+    }
+    if depth == 0 {
+        return None;
+    }
+    for child in surface_read::elements(element, "AXChildren", deadline).unwrap_or_default() {
+        if let Some(found) = find(&child, identifier, depth - 1) {
+            return Some(found);
+        }
+    }
+    None
+}
+
+#[test]
+#[ignore = "Requires the disposable Cognia window fixture and an authorized AX runner"]
+fn retained_object_reparent_is_rejected_at_each_native_write() {
+    let directory = std::path::PathBuf::from(
+        std::env::var_os("COGNIA_AX_FIXTURE_DIR").expect("Fixture path required"),
+    );
+    command(&directory, "reset");
+    let initial = state(&directory);
+    let pid = initial["pid"].as_i64().unwrap() as i32;
+    let app = AXElement(unsafe { accessibility_sys::AXUIElementCreateApplication(pid) });
+    let button = find(&app, "cognia-p0-counter", 8).expect("Fixture button");
+    let field = find(&app, "cognia-p0-field", 8).expect("Fixture field");
+    let mut entry = super::tests::entry(initial["windows"][0].as_str().unwrap());
+    entry.process.pid = agent_desktop_core::ProcessId::new(pid as u32);
+    entry.process.process_instance =
+        crate::system::process::process_identity::token_for_pid(pid).unwrap();
+    let scope = BoundWindowScope::enter(Some(&entry)).unwrap();
+    let deadline = || Instant::now() + Duration::from_secs(3);
+    let press = CFString::new("AXPress");
+    ax_ipc::perform_action(&button, press.as_concrete_TypeRef(), deadline()).unwrap();
+    assert_eq!(state(&directory)["counts"], serde_json::json!([1, 0]));
+    command(&directory, "move");
+    for element in [&button, &field] {
+        let owner = surface_read::element(element, "AXWindow", deadline())
+            .unwrap()
+            .unwrap();
+        let number = crate::system::window::window_bridge::window_id(&owner, deadline())
+            .unwrap()
+            .unwrap();
+        assert_eq!(
+            format!("w-{number}"),
+            initial["windows"][1].as_str().unwrap()
+        );
+    }
+    let press_error =
+        ax_ipc::perform_action(&button, press.as_concrete_TypeRef(), deadline()).unwrap_err();
+    assert_eq!(press_error.disposition, DeliverySemantics::not_delivered());
+    let attribute = CFString::new("AXValue");
+    let text = CFString::new("fixture-updated");
+    let value_error = ax_ipc::set_attribute_value(
+        &field,
+        attribute.as_concrete_TypeRef(),
+        text.as_CFTypeRef(),
+        deadline(),
+    )
+    .unwrap_err();
+    assert_eq!(value_error.disposition, DeliverySemantics::not_delivered());
+    assert_eq!(state(&directory)["counts"], serde_json::json!([1, 0]));
+    assert_eq!(
+        surface_read::string(&field, "AXValue", deadline())
+            .unwrap()
+            .as_deref(),
+        Some("fixture-original")
+    );
+    drop(scope);
+    entry.source.source_window_id = initial["windows"][1].as_str().map(str::to_owned);
+    let _rebound = BoundWindowScope::enter(Some(&entry)).unwrap();
+    ax_ipc::perform_action(&button, press.as_concrete_TypeRef(), deadline()).unwrap();
+    ax_ipc::set_attribute_value(
+        &field,
+        attribute.as_concrete_TypeRef(),
+        text.as_CFTypeRef(),
+        deadline(),
+    )
+    .unwrap();
+    assert_eq!(state(&directory)["counts"], serde_json::json!([1, 1]));
+    assert_eq!(
+        surface_read::string(&field, "AXValue", deadline())
+            .unwrap()
+            .as_deref(),
+        Some("fixture-updated")
+    );
+}
