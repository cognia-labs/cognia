new file mode 100644
index 0000000..4089923
--- /dev/null
+++ b/src/cognia_lease.rs
@@ -0,0 +1,86 @@
+use agent_desktop_core::AppError;
+use std::fs::File;
+use std::os::fd::FromRawFd;
+
+pub(crate) struct SupervisorLease {
+    _file: File,
+}
+
+impl SupervisorLease {
+    pub(crate) fn adopt() -> Result<Option<Self>, AppError> {
+        let Some(value) = std::env::var_os("COGNIA_AUTOMATION_LEASE_FD") else {
+            return Ok(None);
+        };
+        let fd = value
+            .to_str()
+            .and_then(|v| v.parse::<i32>().ok())
+            .filter(|fd| *fd >= 3)
+            .ok_or_else(|| AppError::invalid_input("Invalid supervisor lease descriptor"))?;
+        Self::adopt_descriptor(fd).map(Some)
+    }
+
+    fn adopt_descriptor(fd: i32) -> Result<Self, AppError> {
+        let mut stat = std::mem::MaybeUninit::<libc::stat>::uninit();
+        if unsafe { libc::fstat(fd, stat.as_mut_ptr()) } != 0 {
+            return Err(AppError::invalid_input(
+                "Supervisor lease descriptor is unavailable",
+            ));
+        }
+        let stat = unsafe { stat.assume_init() };
+        if stat.st_mode & libc::S_IFMT != libc::S_IFREG
+            || stat.st_uid != unsafe { libc::geteuid() }
+            || stat.st_mode & 0o077 != 0
+            || stat.st_nlink != 1
+        {
+            return Err(AppError::invalid_input(
+                "Supervisor lease must be a private owned file",
+            ));
+        }
+        if unsafe { libc::flock(fd, libc::LOCK_EX | libc::LOCK_NB) } != 0 {
+            return Err(AppError::invalid_input(
+                "Supervisor lease is not held by this executor",
+            ));
+        }
+        Ok(Self {
+            _file: unsafe { File::from_raw_fd(fd) },
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::os::fd::{AsRawFd, IntoRawFd};
+    use std::os::unix::fs::OpenOptionsExt;
+
+    #[test]
+    fn invalid_or_non_file_descriptor_is_rejected() {
+        assert!(SupervisorLease::adopt_descriptor(-1).is_err());
+        let file = File::open("/dev/null").unwrap();
+        assert!(SupervisorLease::adopt_descriptor(file.as_raw_fd()).is_err());
+    }
+
+    #[test]
+    fn adopted_descriptor_keeps_exclusive_lock_until_drop() {
+        let path = std::env::temp_dir().join(format!("cognia-lease-{}", std::process::id()));
+        let file = std::fs::OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create_new(true)
+            .mode(0o600)
+            .open(&path)
+            .unwrap();
+        let successor = File::open(&path).unwrap();
+        let lease = SupervisorLease::adopt_descriptor(file.into_raw_fd()).unwrap();
+        assert_ne!(
+            unsafe { libc::flock(successor.as_raw_fd(), libc::LOCK_EX | libc::LOCK_NB) },
+            0
+        );
+        drop(lease);
+        assert_eq!(
+            unsafe { libc::flock(successor.as_raw_fd(), libc::LOCK_EX | libc::LOCK_NB) },
+            0
+        );
+        std::fs::remove_file(path).unwrap();
+    }
+}
