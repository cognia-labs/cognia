    {
      "id": "colocated-test-baseline",
      "file": "scripts/gates/colocated-test-baseline.json",
      "gate": "audit:colocated-tests",
      "measures": [
        {
          "id": "files",
          "kind": "length",
          "path": "files"
        }
      ]
    },
    {
