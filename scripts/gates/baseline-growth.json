  "notRatchets": [
    {
      "file": "scripts/gates/host-parity-annotations.json",
      "reason": "Classifies subsystems (unmigrated, ui-assumption, physically-impossible, seam-infrastructure); it does not tolerate findings. The findings it explains are ratcheted by host-parity-baseline.json above."
    },
    {
      "file": "scripts/gates/frozen-wasm-api.json",
      "reason": "A frozen snapshot of the archived WASM API that must never change at all; check-frozen-wasm-api.mjs fails on any edit, so growth is already impossible."
    },
    {
      "file": "scripts/gates/sidecar-architecture.json",
      "reason": "The sidecar layer map (ADR-0197): layer assignments, launcher paths and the public surface. It holds decisions, not tolerated findings; tolerated findings live in sidecar-architecture-baseline.json above."
    },
    {
      "file": "packages/plugin-contract/contract/api-surface-baseline.json",
      "reason": "A snapshot of the published plugin API surface used to detect breaking removals; growth is the contract gaining methods, which is not debt."
    },
    {
      "file": "scripts/test/db-fixture-exclusions.json",
      "reason": "Tests that require real database recreation (schema, migration, connection lifecycle or timer behavior), not a shrinking debt allowance. Legacy reset debt is counted separately by db-fixture-baseline.json."
    },
    {
      "file": "protocol/external-agent-security-policy.json",
      "reason": "Runtime binary and package security allowlists mirrored into launchers and checked against shipped presets. New supported runtimes legitimately extend this policy; it is not an only-shrink debt waiver."
    },
    {
      "file": "lib/usage/model-price-catalog.generated.json",
      "reason": "Generated provider prices, not adjustable debt ceilings. check-price-catalog.mjs owns the fixed 250 KB ceiling in code and validates this artifact; more supported models are not baseline growth."
    },
    {
      "file": "plugins/pi-latex-workbench/plugin.json",
      "reason": "The bundle_include packaging allowlist is generated from the pinned vendor tree and Cognia glue. Its gate checks exact content; adding shipped files is not an only-shrink debt exemption."
    },
    {
      "file": "packages/plugin-contract/contract/code-1.128-ide.json",
      "reason": "The versioned IDE capability catalog includes supported APIs and compatibility exceptions. It describes the published contract; additional supported APIs are not tolerated architecture debt."
    },
    {
      "file": "protocol/companion-verbs.json",
      "reason": "The closed command verb vocabulary contains definitions and refused aliases, not tolerated violations. Reviewed verbs may be added for new operations; it is not an only-shrink baseline."
    },
    {
      "file": "protocol/companion-request-schemas.json",
      "reason": "Canonical request schemas include the generated settings write allowlist and API validation bounds. These describe supported inputs, not tolerated findings; new supported settings are not debt growth."
    },
    {
      "file": "protocol/headless-command-dispositions.json",
      "reason": "Classifies command ownership and exposure (local-only, runtime-internal, covered or separate-design-required). This is a transport contract, not an only-shrink waiver; tolerated parity findings have their own ratcheted baselines."
    }
  ]
}
