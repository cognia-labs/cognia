{
  "name": "@cognia/primitives",
  "version": "0.0.0",
  "private": true,
  "description": "Cognia framework-agnostic primitives: concurrency, caching, timeout helpers, and structured-response JSON extraction.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "cognia-source": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "cognia-source": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
