{
  "name": "@cognia/content-safety",
  "version": "0.0.0",
  "private": true,
  "description": "Runtime-neutral content safety assessment: privacy findings, prompt-injection detection, and explicit inspection status.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "cognia-source": "./src/index.ts",
      "types": "./src/index.ts",
      "node": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cognia/redact": "workspace:*"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
