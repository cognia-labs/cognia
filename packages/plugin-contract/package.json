{
  "name": "@cognia/plugin-contract",
  "version": "0.0.0",
  "private": true,
  "description": "The Cognia plugin contract: the manifest, the ctx.* API surfaces and the domain types they carry. The host implements it and @cognia/plugin-sdk re-exports it; it imports no host source.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "cognia-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./*": {
      "cognia-source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=16384 node scripts/build-package.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "zustand": "^5.0.15"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@cognia/agent": "workspace:*",
    "@cognia/agent-contracts": "workspace:*",
    "@cognia/agent-orchestration": "workspace:*",
    "@cognia/agent-trace": "workspace:*",
    "@cognia/document": "workspace:*",
    "@cognia/eval-core": "workspace:*",
    "@cognia/github-bot-kit": "workspace:*",
    "@cognia/logging": "workspace:*",
    "@cognia/memory": "workspace:*",
    "@cognia/ocr": "workspace:*",
    "@cognia/primitives": "workspace:*",
    "@cognia/provider-core": "workspace:*",
    "@cognia/provider-embedding": "workspace:*",
    "@cognia/provider-types": "workspace:*",
    "@cognia/rag": "workspace:*",
    "@cognia/redact": "workspace:*",
    "@cognia/router-fusion": "workspace:*",
    "@cognia/tts": "workspace:*",
    "@cognia/web-search": "workspace:*"
  }
}
