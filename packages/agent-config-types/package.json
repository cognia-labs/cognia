{
  "name": "@cognia/agent-config-types",
  "version": "0.0.0",
  "private": true,
  "description": "Compatibility entry points for Cognia agent configuration contracts owned by plugin-contract, plus host-specific configuration helpers.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "cognia-source": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./claude-agent-sdk-options": {
      "cognia-source": "./src/claude-agent-sdk-options.ts",
      "types": "./src/claude-agent-sdk-options.ts",
      "node": "./dist/claude-agent-sdk-options.js",
      "default": "./src/claude-agent-sdk-options.ts"
    },
    "./plugin-interception": {
      "cognia-source": "./src/plugin-interception.ts",
      "types": "./src/plugin-interception.ts",
      "node": "./dist/plugin-interception.js",
      "default": "./src/plugin-interception.ts"
    },
    "./*": {
      "cognia-source": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cognia/agent": "workspace:*",
    "@cognia/agent-contracts": "workspace:*",
    "@cognia/memory": "workspace:*",
    "@cognia/plugin-contract": "workspace:*",
    "@cognia/provider-types": "workspace:*",
    "@cognia/router-fusion": "workspace:*",
    "@cognia/web-search": "workspace:*"
  },
  "peerDependencies": {
    "ai": "*"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "tsup": "^8.5.1"
  }
}
