# Build context filter for deploy/docker/Dockerfile.cognia-server (ADR-0059 P0.2/W6).
# The context is the repo root; without this file it would ship multi-GB
# node_modules / target / out trees to the daemon on every build.
# services/* have their own Dockerfiles with their own directories as context —
# this file does not apply to them.

# Dependency trees (reinstalled inside the image)
node_modules
**/node_modules
.pnpm-store

# Build outputs
out
.next
**/.next
docs/.source
# docs static export (hundreds of MB) — `out` above only matches the root.
# Keep this a precise path: **/out would swallow the vscode-extension
# template's out/extension.js, an include_str! target.
docs/out
target
**/target
cli/dist
dist
build
coverage
**/coverage
playwright-report
test-results
storybook-static

# First-party plugin source never enters an image. Images consume the verified
# plugin artifact set through the `plugin-artifacts` named build context
# (docs/plans/2026-10-30-plugins-repository-extraction.md §5 and §9), so the
# build keeps working once plugins/ lives in its own repository.
plugins

# Workspace package builds from the caller's checkout. Each image compiles
# them itself; a host copy would only skew the layer cache and the build.
packages/*/dist

# Mobile native shells (never part of the container build)
mobile/ios
mobile/android

# VCS / editor / local state
.cache
.git
.github
.husky
.vscode
.idea
.claude
.codegraph
*.log
.env
.env.*
!.env.example

# Tauri bundle artifacts
src-tauri/gen
src-tauri/binaries

# Docs content feeds the main app's generated Support Agent corpus.
# Only the docs site's separate public assets are unnecessary here.
docs/public

# Re-include the workspace manifests the brain-builder stage COPYs explicitly
# (.dockerignore applies to every COPY, so excluded parents need whitelists).
!docs/package.json
!mobile/package.json
!packages/*/package.json
