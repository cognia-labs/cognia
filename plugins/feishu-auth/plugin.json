{
  "id": "feishu-auth",
  "name": "Feishu Authentication",
  "nameKey": "manifest.name",
  "version": "1.0.0",
  "type": "frontend",
  "description": "Host-managed Feishu and Lark user and bot authentication for service plugins.",
  "descriptionKey": "manifest.description",
  "author": "Cognia Official",
  "license": "MIT",
  "minAppVersion": "0.1.0",
  "engines": {
    "cognia": ">=0.1.0"
  },
  "main": "src/index.ts",
  "capabilities": ["auth-provider"],
  "permissions": ["auth:provide", "network:fetch"],
  "authProviders": [
    {
      "id": "feishu-user-oauth",
      "label": "Feishu user OAuth",
      "authorization": {
        "clientIdFrom": {
          "configuration": "appId"
        },
        "issuer": "https://accounts.feishu.cn"
      },
      "configurationSchema": {
        "type": "object",
        "properties": {
          "appId": {
            "type": "string",
            "minLength": 1
          },
          "clientSecret": {
            "type": "string",
            "format": "secret",
            "minLength": 1
          },
          "redirectUri": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": ["appId"]
      },
      "methods": ["oauth-pkce", "client-credentials"],
      "principals": ["user", "bot"],
      "issuers": ["https://accounts.feishu.cn", "https://accounts.larksuite.com"],
      "tokenEndpoints": [
        {
          "url": "https://open.feishu.cn/open-apis/authen/v2/oauth/token",
          "clientSecret": "json"
        },
        {
          "url": "https://open.feishu.cn/open-apis/auth/v3/tenant_access_token/internal",
          "clientSecret": "json",
          "credentialFields": {
            "clientId": "app_id",
            "clientSecret": "app_secret"
          }
        },
        {
          "url": "https://open.larksuite.com/open-apis/authen/v2/oauth/token",
          "clientSecret": "json"
        },
        {
          "url": "https://open.larksuite.com/open-apis/auth/v3/tenant_access_token/internal",
          "clientSecret": "json",
          "credentialFields": {
            "clientId": "app_id",
            "clientSecret": "app_secret"
          }
        }
      ]
    }
  ],
  "networkAccess": {
    "allowedDomains": ["open.feishu.cn", "open.larksuite.com"],
    "rules": [
      {
        "domain": "open.feishu.cn",
        "methods": ["POST"],
        "paths": ["/open-apis/authen/v2/oauth/token"]
      },
      {
        "domain": "open.feishu.cn",
        "methods": ["POST"],
        "paths": ["/open-apis/auth/v3/tenant_access_token/internal"]
      },
      {
        "domain": "open.feishu.cn",
        "methods": ["GET"],
        "paths": ["/open-apis/authen/v1/user_info", "/open-apis/tenant/v2/tenant/query"]
      },
      {
        "domain": "open.larksuite.com",
        "methods": ["POST"],
        "paths": ["/open-apis/authen/v2/oauth/token"]
      },
      {
        "domain": "open.larksuite.com",
        "methods": ["POST"],
        "paths": ["/open-apis/auth/v3/tenant_access_token/internal"]
      },
      {
        "domain": "open.larksuite.com",
        "methods": ["GET"],
        "paths": ["/open-apis/authen/v1/user_info", "/open-apis/tenant/v2/tenant/query"]
      }
    ]
  },
  "runtimeCompatibility": {
    "tauri": {
      "availability": "supported",
      "entrypoint": "src/index.ts"
    },
    "headless": {
      "availability": "degraded",
      "entrypoint": "src/index.ts",
      "reason": "Bot connections and existing user connections require a trusted Host; initial PKCE sign-in needs an interactive shell."
    },
    "browser": {
      "availability": "degraded",
      "entrypoint": "src/index.ts",
      "reason": "Confidential exchange requires a connected trusted Host and PKCE requires a registered callback."
    },
    "mobile": {
      "availability": "degraded",
      "entrypoint": "src/index.ts",
      "reason": "Confidential exchange requires a connected trusted Host and PKCE requires a registered callback."
    }
  },
  "i18n": {
    "locales": {
      "en": {
        "manifest.name": "Feishu Authentication",
        "manifest.description": "Shared Feishu and Lark authentication; the Host stores credentials and coordinates refresh."
      },
      "zh-CN": {
        "manifest.name": "飞书认证",
        "manifest.description": "共享飞书与 Lark 认证，由 Host 保存凭证并统一协调刷新。"
      }
    }
  },
  "providesServices": {
    "auth.feishu": "1.0.0"
  }
}
