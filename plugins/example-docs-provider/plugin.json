{
  "id": "cognia-example-docs-provider",
  "name": "Example Tracker Documents",
  "description": "Credential-free document reads through a granted Host connection.",
  "version": "0.1.0",
  "type": "frontend",
  "main": "dist/index.js",
  "author": "Cognia plugin authors",
  "license": "MIT",
  "minAppVersion": "0.1.0",
  "engines": {
    "cognia": ">=0.1.0"
  },
  "capabilities": ["docs-provider", "integrations", "commands"],
  "permissions": ["auth:consume", "integrations:read", "integrations:execute", "docs:provide"],
  "runtimeCompatibility": {
    "tauri": {
      "availability": "supported",
      "entrypoint": "dist/index.js"
    },
    "browser": {
      "availability": "blocked",
      "entrypoint": "dist/index.js",
      "reason": "confidential-exchange-unavailable",
      "recovery": ["pair-with-desktop", "use-always-on-host"]
    },
    "mobile": {
      "availability": "blocked",
      "entrypoint": "dist/index.js",
      "reason": "confidential-exchange-unavailable",
      "recovery": ["pair-with-desktop", "use-always-on-host"]
    },
    "headless": {
      "availability": "degraded",
      "entrypoint": "dist/index.js",
      "reason": "no-interactive-browser",
      "recovery": ["use-another-method"]
    }
  },
  "requiresServices": {
    "auth.example-tracker": "^1.0.0"
  },
  "integrations": [
    {
      "id": "docs",
      "label": "Example Tracker Documents",
      "authStrategies": [
        {
          "id": "oauth",
          "type": "oauth2",
          "label": "Example Tracker user",
          "providerId": "example-tracker",
          "scopes": ["docs.read"],
          "requestAuth": {
            "type": "bearer"
          }
        }
      ],
      "allowedOrigins": ["https://api.example-tracker.test"],
      "resourceKinds": [],
      "eventTypes": [],
      "actions": []
    }
  ],
  "services": [
    {
      "id": "docs",
      "label": "Example Tracker Documents",
      "fallbackPolicy": "never",
      "providers": [
        {
          "id": "api",
          "kind": "integration",
          "contributionId": "docs",
          "priority": 1,
          "surfaces": ["chat", "workflow"]
        }
      ]
    }
  ],
  "commands": [
    {
      "id": "example-docs-connect",
      "name": "/example-docs-connect",
      "description": "Select a connection and request this plugin's consumer grant."
    }
  ],
  "i18n": {
    "locales": {
      "en": {
        "access.granted": "Connection access granted.",
        "access.denied": "Connection access was not granted."
      },
      "zh-CN": {
        "access.granted": "\u5df2\u6388\u6743\u8fde\u63a5\u8bbf\u95ee\u3002",
        "access.denied": "\u5c1a\u672a\u6388\u6743\u8fde\u63a5\u8bbf\u95ee\u3002"
      }
    }
  },
  "docsProviders": [
    {
      "id": "docs",
      "label": "Example Tracker Documents",
      "mentionPrefix": "cognia-example-docs-provider.docs:",
      "kinds": ["doc"],
      "urlOrigins": ["https://docs.example-tracker.test"]
    }
  ]
}
