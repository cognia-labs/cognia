{
  "id": "cognia-example-sync",
  "name": "Example Sync",
  "version": "1.0.0",
  "description": "Author reference: page a fictional remote through Host-owned sync cursors.",
  "type": "frontend",
  "main": "src/index.ts",
  "author": "Cognia",
  "license": "MIT",
  "engines": {
    "cognia": ">=0.1.0"
  },
  "capabilities": ["sync"],
  "permissions": ["sync:run"],
  "runtimeCompatibility": {
    "tauri": {
      "availability": "supported",
      "entrypoint": "src/index.ts"
    },
    "browser": {
      "availability": "degraded",
      "entrypoint": "src/index.ts",
      "reason": "background-sync-unavailable",
      "recovery": ["pair-with-desktop", "use-always-on-host"]
    },
    "mobile": {
      "availability": "degraded",
      "entrypoint": "src/index.ts",
      "reason": "background-sync-unavailable",
      "recovery": ["pair-with-desktop", "use-always-on-host"]
    },
    "headless": {
      "availability": "supported",
      "entrypoint": "src/index.ts"
    }
  },
  "icon": "assets/icon.png"
}
