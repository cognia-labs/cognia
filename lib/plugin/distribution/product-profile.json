  "desktop": {
    "repowiki": {
      "id": "cognia-repowiki",
      "reason": "ADR-0146 product subsystem: repository wiki generation, dependency graph, cited search. Its 326-case pytest suite ships as source in the repo, not in the installer.",
      "include": [
        "plugin.json",
        "assets/icon.png",
        "main.py",
        "pyproject.toml",
        "README.md",
        "LICENSE.upstream",
        "repowiki/**/*.py"
      ]
    },
    "cognia-laya-guard": {
      "id": "cognia-laya-guard",
      "reason": "ADR-0194 decision provider: Settings → Conversation → Decision provider lists \"Laya (local)\", and the inbound IM moderation hook ships with it. Seeded but manual-enable only, because activation provisions a Python venv and downloads the laya checkpoint. Calibration tools and the pytest suite stay in the repo.",
      "include": [
        "plugin.json",
        "assets/icon.png",
        "main.py",
        "pyproject.toml",
        "README.md",
        "layaguard/**/*.py"
      ]
    }
  },
  "companions": [
    {
      "directory": "cognia-office",
      "id": "cognia-office"
    }
  ],
  "devOnly": {
    "cognia-python-demo": "Author reference: the smallest possible Python plugin. Copy-paste template, not a default.",
    "cognia-python-runtime-demo": "Author reference for the Python reverse-RPC surface (ADR-0145). Exercises the contract rather than doing user-facing work.",
    "wasm-example-formatter": "Author reference for the WASM component ABI. Its artifact is built by `cargo component` on demand and is not checked in, so there is nothing stable to stage."
  }
