        "denyReadable": [".hermes"]
      },
      "relocation": {
        "env": ["HERMES_HOME"],
        "temp": "tmp"
      }
    },
    {
      "id": "oh-my-pi",
      "match": {
        "kind": "base",
        "values": ["omp"]
      },
      "stateRoots": [".omp"]
    },
    {
      "id": "muse",
      "match": {
        "kind": "base",
        "values": ["muse-acp"]
      },
      "stateRoots": [".config/muse", ".local/state/muse-acp"]
    },
    {
      "id": "amp",
      "match": {
