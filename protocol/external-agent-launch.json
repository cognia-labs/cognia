{
  "description": "Engine launch descriptors (ADR-0217), generated from the integration packages by scripts/build/gen-external-agent-launch.mjs; edit the descriptor in its package. Both process hosts (crates/cognia-external-agent, cli/src/runtime/external) read this file and name no engine themselves. A launch matches by its target: for `npx <package>` the package, otherwise the executable file name without a Windows suffix, lower-cased.",
  "engines": [
    {
      "id": "claude-code",
      "match": {
        "kind": "target",
        "values": [
          "claude",
          "claude-agent-acp",
          "claude-code-acp",
          "@agentclientprotocol/claude-agent-acp",
          "@anthropic-ai/claude-code",
          "@zed-industries/claude-code-acp"
        ]
      },
      "stateRoots": [".claude", ".claude.json", ".claude.json.backup"],
      "fileRoots": [".claude.json", ".claude.json.backup"],
      "isolation": {
        "env": {
          "CLAUDE_CONFIG_DIR": "claude"
        },
        "sharedRoots": [".claude", ".claude.json", ".claude.json.backup"],
        "denyReadable": [".claude", ".claude.json", ".claude.json.backup"]
      }
    },
    {
      "id": "codex",
      "match": {
        "kind": "contains",
        "values": ["codex"]
      },
      "stateRoots": [".codex"],
      "isolation": {
        "env": {
          "CODEX_HOME": "codex"
        },
        "sharedRoots": [".codex"],
        "denyReadable": [".codex"]
      }
    },
    {
      "id": "opencode",
      "match": {
        "kind": "contains",
        "values": ["opencode"]
      },
      "stateRoots": [".config/opencode", ".local/share/opencode"],
      "isolation": {
        "env": {
          "OPENCODE_CONFIG_DIR": "config/opencode",
          "XDG_DATA_HOME": "data",
          "XDG_STATE_HOME": "state",
          "XDG_CACHE_HOME": "cache"
        },
        "sharedRoots": [".config/opencode", ".local/share/opencode"],
        "denyReadable": [".config/opencode", ".local/share/opencode"]
      }
    },
    {
      "id": "pi",
      "match": {
        "kind": "base",
        "values": ["pi"]
      },
      "stateRoots": [".pi"],
      "isolation": {
        "env": {
          "PI_CODING_AGENT_DIR": "pi"
        },
        "sharedRoots": [".pi"],
        "denyReadable": [".pi"]
      }
    },
    {
      "id": "openclaude",
      "match": {
        "kind": "base",
        "values": ["openclaude"]
      },
      "stateRoots": [".openclaude", ".openclaude.json"],
      "fileRoots": [".openclaude.json"],
      "isolation": {
        "env": {
          "OPENCLAUDE_CONFIG_DIR": "openclaude"
        },
        "sharedRoots": [".openclaude", ".openclaude.json"],
        "denyReadable": [".openclaude", ".openclaude.json"]
      },
      "relocation": {
        "env": ["OPENCLAUDE_CONFIG_DIR"],
        "temp": "tmp"
      }
    },
    {
      "id": "crush",
      "match": {
        "kind": "base",
        "values": ["crush"]
      },
      "stateRoots": [".config/crush", ".local/share/crush", ".local/state/crush", ".cache/crush"]
    },
    {
      "id": "continue-dev",
      "match": {
        "kind": "base",
        "values": ["cn"]
      },
      "stateRoots": [".continue"]
    },
    {
      "id": "rovo-dev",
      "match": {
        "kind": "base",
        "values": ["acli"]
      },
      "stateRoots": [".config/acli", ".rovodev"]
    },
    {
      "id": "antigravity-acp",
      "match": {
        "kind": "base",
        "values": ["agy_acp_server.par", "agy_acp_server"]
      },
      "stateRoots": [".gemini/antigravity-acp", ".gemini/artifacts"],
      "relocation": {
        "env": ["GEMINI_HOME"],
        "skipEmpty": true,
        "expandTilde": true,
        "default": ".gemini",
        "writable": ["antigravity-acp", "artifacts"],
        "temp": "antigravity-acp/tmp"
      },
      "companion": {
        "sibling": "localharness_external",
        "env": "ANTIGRAVITY_HARNESS_PATH"
      },
      "privateLaunchUnsupported": "its native keychain accounts are shared",
      "platformArgs": {
        "linux": ["--uid="]
      }
    },
    {
      "id": "minimax-code",
      "match": {
        "kind": "base",
        "values": ["mcode"]
      },
      "stateRoots": [".minimax"],
      "relocation": {
        "env": ["MINIMAX_DATA_DIR", "MAVIS_DATA_DIR"],
        "skipEmpty": true,
        "default": ".minimax",
        "temp": "tmp"
      },
      "isolation": {
        "env": {
          "MINIMAX_DATA_DIR": "minimax",
          "MAVIS_DATA_DIR": "minimax"
        },
        "sharedRoots": [".minimax"],
        "denyReadable": [".minimax"]
      }
    },
    {
      "id": "kimi",
      "match": {
        "kind": "base",
        "values": ["kimi"]
      },
      "stateRoots": [".kimi-code"],
      "relocation": {
        "env": ["KIMI_CODE_HOME"],
        "default": ".kimi-code",
        "temp": "tmp",
        "setEnv": {
          "KIMI_CODE_NO_AUTO_UPDATE": "1",
          "KIMI_CODE_BACKGROUND_KEEP_ALIVE_ON_EXIT": "0"
        }
      },
      "isolation": {
        "env": {
          "KIMI_CODE_HOME": "kimi"
        },
        "sharedRoots": [".kimi-code"],
        "denyReadable": [".kimi-code", ".kimi"]
      }
    },
    {
      "id": "cline",
      "match": {
        "kind": "base",
        "values": ["cline"]
      },
      "stateRoots": [".cline"],
      "relocation": {
        "env": ["CLINE_DIR"],
        "args": {
          "flags": ["--config"],
          "pick": "first"
        },
        "refusedArgs": ["--data-dir"],
        "trim": true,
        "default": ".cline",
        "temp": "tmp",
        "setEnv": {
          "CLINE_NO_AUTO_UPDATE": "1"
        }
      },
      "isolation": {
        "env": {
          "CLINE_DIR": "cline"
        },
        "sharedRoots": [".cline"],
        "denyReadable": [".cline"]
      }
    },
    {
      "id": "copilot-cli",
      "match": {
        "kind": "contains",
        "values": ["copilot"]
      },
      "stateRoots": [".copilot", ".cache/copilot"],
      "isolation": {
        "env": {
          "COPILOT_HOME": "copilot"
        },
        "sharedRoots": [".copilot"],
        "denyReadable": [".copilot"]
      }
    },
    {
      "id": "qoder",
      "match": {
        "kind": "base",
        "values": ["qoder"]
      },
      "stateRoots": [".qoder"],
      "relocation": {
        "env": ["QODER_CONFIG_DIR"],
        "args": {
          "flags": ["--config-dir"],
          "pick": "last"
        },
        "default": ".qoder",
        "temp": "tmp"
      },
      "isolation": {
        "env": {
          "QODER_CONFIG_DIR": "qoder"
        },
        "sharedRoots": [".qoder"],
        "denyReadable": []
      }
    },
    {
      "id": "goose",
      "match": {
        "kind": "base",
        "values": ["goose"]
      },
      "stateRoots": [
        ".config/goose",
        ".local/share/goose",
        ".local/state/goose",
        "Library/Application Support/Block/goose"
      ],
      "isolation": {
        "env": {
          "GOOSE_PATH_ROOT": "goose"
        },
        "setEnv": {
          "GOOSE_DISABLE_KEYRING": "1"
        },
        "sharedRoots": [
          ".config/goose",
          ".local/share/goose",
          ".local/state/goose",
          "Library/Application Support/Block/goose"
        ],
        "denyReadable": [
          ".config/goose",
          ".local/share/goose",
          ".local/state/goose",
          "Library/Application Support/Block/goose"
        ]
      },
      "temp": {
        "home": ".local/state/goose/tmp",
        "isolated": {
          "env": "GOOSE_PATH_ROOT",
          "path": "state/tmp"
        }
      }
    },
    {
      "id": "grok",
      "match": {
        "kind": "base",
        "values": ["grok"]
      },
      "stateRoots": [".grok"],
      "relocation": {
        "env": ["GROK_HOME"],
        "default": ".grok",
        "temp": "tmp",
        "setEnv": {
          "GROK_DISABLE_AUTOUPDATER": "1",
          "GROK_CHANGELOG_OFFLINE": "1"
        }
      },
      "isolation": {
        "env": {
          "GROK_HOME": "grok"
        },
        "sharedRoots": [".grok"],
        "denyReadable": [".grok"]
      }
    },
    {
      "id": "devin",
      "match": {
        "kind": "base",
        "values": ["devin"]
      },
      "stateRoots": [".config/devin", ".local/share/devin", ".cache/devin"]
    },
    {
      "id": "auggie",
      "match": {
        "kind": "base",
        "values": ["auggie"]
      },
      "stateRoots": [".augment"]
    },
