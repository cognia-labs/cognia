{
  "description": "Engine launch descriptors (ADR-0217), generated from the integration packages by scripts/build/gen-external-agent-launch.mjs; edit the descriptor in its package. Both process hosts (crates/cognia-external-agent, cli/src/runtime/external) read this file and name no engine themselves. A launch matches by its target: for `npx <package>` the package, otherwise the executable file name without a Windows suffix, lower-cased.",
  "engines": [
    {
      "id": "aider",
      "match": {
        "kind": "base",
        "values": ["aider"]
      },
      "env": {
        "keys": [
          "AIDER_MODEL",
          "AIDER_WEAK_MODEL",
          "AIDER_EDITOR_MODEL",
          "AIDER_EDIT_FORMAT",
          "AIDER_EDITOR_EDIT_FORMAT",
          "AIDER_REASONING_EFFORT",
          "AIDER_THINKING_TOKENS"
        ],
        "reviewedPrefixes": ["AIDER_"],
        "reviewedRequestOnly": true
      },
      "hiddenFiles": {
        "searched": [
          ".aider.conf.yml",
          ".env",
          ".aider.model.settings.yml",
          ".aider.model.metadata.json"
        ],
        "home": [".aider/oauth-keys.env"]
      },
      "loginRoots": [".aider"]
    },
    {
      "id": "claude-code",
      "match": {
        "kind": "target",
        "values": [
          "claude",
          "claude-agent-acp",
          "claude-code-acp",
          "@agentclientprotocol/claude-agent-acp",
          "@anthropic-ai/claude-code",
          "@zed-industries/claude-code-acp"
        ]
      },
      "env": {
        "prefixes": ["ANTHROPIC_", "CLAUDE_"]
      },
      "stateRoots": [".claude", ".claude.json", ".claude.json.backup"],
      "fileRoots": [".claude.json", ".claude.json.backup"],
      "isolation": {
        "env": {
          "CLAUDE_CONFIG_DIR": "claude"
        },
        "sharedRoots": [".claude", ".claude.json", ".claude.json.backup"],
        "denyReadable": [".claude", ".claude.json", ".claude.json.backup"]
      }
    },
    {
      "id": "codex",
      "match": {
        "kind": "contains",
        "values": ["codex"]
      },
      "env": {
        "keys": ["NO_BROWSER", "INITIAL_AGENT_MODE", "APP_SERVER_LOGS", "MODEL_PROVIDER"],
        "prefixes": ["CODEX_", "OPENAI_"]
      },
      "extraWritableRoots": true,
      "stderrNoise": [
        ["codex_models_manager", "failed to load models cache"],
        ["codex_models_manager", "failed to renew cache"]
      ],
      "stateRoots": [".codex"],
      "isolation": {
        "env": {
          "CODEX_HOME": "codex"
        },
        "sharedRoots": [".codex"],
        "denyReadable": [".codex"]
      }
    },
    {
      "id": "opencode",
      "match": {
        "kind": "contains",
        "values": ["opencode"]
      },
      "env": {
        "prefixes": ["OPENCODE_"]
      },
      "stateRoots": [".config/opencode", ".local/share/opencode"],
      "isolation": {
        "env": {
          "OPENCODE_CONFIG_DIR": "config/opencode",
          "XDG_DATA_HOME": "data",
          "XDG_STATE_HOME": "state",
          "XDG_CACHE_HOME": "cache"
        },
        "sharedRoots": [".config/opencode", ".local/share/opencode"],
        "denyReadable": [".config/opencode", ".local/share/opencode"]
      }
    },
    {
      "id": "pi",
      "match": {
        "kind": "base",
        "values": ["pi"]
      },
      "env": {
        "keys": ["PI_CODING_AGENT_DIR", "PI_CODING_AGENT_SESSION_DIR"]
      },
      "piPackages": true,
      "stateRoots": [".pi"],
      "isolation": {
        "env": {
          "PI_CODING_AGENT_DIR": "pi"
        },
        "sharedRoots": [".pi"],
        "denyReadable": [".pi"]
      }
    },
    {
      "id": "openclaude",
      "match": {
        "kind": "base",
        "values": ["openclaude"]
      },
      "env": {
        "prefixes": ["OPENCLAUDE_"]
      },
      "stateRoots": [".openclaude", ".openclaude.json"],
      "fileRoots": [".openclaude.json"],
      "isolation": {
        "env": {
          "OPENCLAUDE_CONFIG_DIR": "openclaude"
        },
        "sharedRoots": [".openclaude", ".openclaude.json"],
        "denyReadable": [".openclaude", ".openclaude.json"]
      },
      "relocation": {
        "env": ["OPENCLAUDE_CONFIG_DIR"],
        "temp": "tmp"
      }
    },
    {
      "id": "crush",
      "match": {
        "kind": "base",
        "values": ["crush"]
      },
      "stateRoots": [".config/crush", ".local/share/crush", ".local/state/crush", ".cache/crush"]
    },
    {
      "id": "continue-dev",
      "match": {
        "kind": "base",
        "values": ["cn"]
      },
      "env": {
        "prefixes": ["CONTINUE_"]
      },
      "stateRoots": [".continue"]
    },
    {
      "id": "rovo-dev",
      "match": {
        "kind": "base",
        "values": ["acli"]
      },
      "env": {
        "prefixes": ["ROVODEV_"]
      },
      "stateRoots": [".config/acli", ".rovodev"]
    },
    {
      "id": "antigravity-acp",
      "match": {
        "kind": "base",
        "values": ["agy_acp_server.par", "agy_acp_server"]
      },
      "env": {
        "keys": ["AGY_ACP_FORCE_FILE_STORAGE"]
      },
      "stateRoots": [".gemini/antigravity-acp", ".gemini/artifacts"],
      "relocation": {
        "env": ["GEMINI_HOME"],
        "skipEmpty": true,
        "expandTilde": true,
        "default": ".gemini",
        "writable": ["antigravity-acp", "artifacts"],
        "temp": "antigravity-acp/tmp"
      },
      "companion": {
        "sibling": "localharness_external",
        "env": "ANTIGRAVITY_HARNESS_PATH"
      },
      "privateLaunchUnsupported": "its native keychain accounts are shared",
      "platformArgs": {
        "linux": ["--uid="]
      }
    },
    {
      "id": "minimax-code",
      "match": {
        "kind": "base",
        "values": ["mcode"]
      },
      "env": {
        "keys": [
          "MINIMAX_DATA_DIR",
          "MAVIS_DATA_DIR",
          "MCODE_PROVIDER_API_KEY",
          "MCODE_LLM_FIRST_EVENT_TIMEOUT_MS",
          "MCODE_LLM_STREAM_IDLE_TIMEOUT_MS"
        ]
      },
      "stateRoots": [".minimax"],
      "relocation": {
        "env": ["MINIMAX_DATA_DIR", "MAVIS_DATA_DIR"],
        "skipEmpty": true,
        "default": ".minimax",
        "temp": "tmp"
      },
      "isolation": {
        "env": {
          "MINIMAX_DATA_DIR": "minimax",
          "MAVIS_DATA_DIR": "minimax"
        },
        "sharedRoots": [".minimax"],
        "denyReadable": [".minimax"]
      }
    },
    {
      "id": "kimi",
      "match": {
        "kind": "base",
        "values": ["kimi"]
      },
      "env": {
        "keys": [
          "KIMI_CODE_HOME",
          "KIMI_CODE_NO_AUTO_UPDATE",
          "KIMI_CODE_BACKGROUND_KEEP_ALIVE_ON_EXIT",
          "KIMI_DISABLE_TELEMETRY",
          "KIMI_MODEL_NAME",
          "KIMI_MODEL_PROVIDER_TYPE",
          "KIMI_MODEL_BASE_URL",
          "KIMI_MODEL_API_KEY",
          "KIMI_MODEL_CAPABILITIES",
          "KIMI_MODEL_DISPLAY_NAME",
          "KIMI_MODEL_MAX_CONTEXT_SIZE",
          "KIMI_MODEL_MAX_OUTPUT_SIZE",
          "KIMI_MODEL_MAX_COMPLETION_TOKENS",
          "KIMI_MODEL_REASONING_KEY",
          "KIMI_MODEL_ADAPTIVE_THINKING",
          "KIMI_MODEL_TEMPERATURE",
          "KIMI_MODEL_TOP_P",
          "KIMI_MODEL_THINKING_EFFORT",
          "KIMI_MODEL_THINKING_KEEP",
          "KIMI_MCP_STARTUP_TIMEOUT_MS",
          "KIMI_MCP_TOOL_TIMEOUT_MS",
          "KIMI_LOOP_MAX_STEPS_PER_TURN",
          "KIMI_LOOP_MAX_ATTEMPTS_PER_STEP"
        ],
        "reviewedPrefixes": ["KIMI_"]
      },
      "stateRoots": [".kimi-code"],
      "relocation": {
        "env": ["KIMI_CODE_HOME"],
        "default": ".kimi-code",
        "temp": "tmp",
        "setEnv": {
          "KIMI_CODE_NO_AUTO_UPDATE": "1",
          "KIMI_CODE_BACKGROUND_KEEP_ALIVE_ON_EXIT": "0"
        }
      },
      "isolation": {
        "env": {
          "KIMI_CODE_HOME": "kimi"
        },
        "sharedRoots": [".kimi-code"],
        "denyReadable": [".kimi-code", ".kimi"]
      }
    },
    {
      "id": "cline",
      "match": {
        "kind": "base",
        "values": ["cline"]
      },
      "env": {
        "keys": [
          "CLINE_API_KEY",
          "CLINE_PROVIDER",
          "CLINE_MODEL",
          "CLINE_DIR",
          "CLINE_NO_AUTO_UPDATE"
        ]
      },
      "stateRoots": [".cline"],
      "relocation": {
        "env": ["CLINE_DIR"],
        "args": {
          "flags": ["--config"],
          "pick": "first"
        },
        "refusedArgs": ["--data-dir"],
        "trim": true,
        "default": ".cline",
        "temp": "tmp",
        "setEnv": {
          "CLINE_NO_AUTO_UPDATE": "1"
        }
      },
      "isolation": {
        "env": {
          "CLINE_DIR": "cline"
        },
        "sharedRoots": [".cline"],
        "denyReadable": [".cline"]
      }
    },
    {
      "id": "copilot-cli",
      "match": {
        "kind": "contains",
        "values": ["copilot"]
      },
      "env": {
        "prefixes": ["COPILOT_", "GITHUB_", "GH_"]
      },
      "stateRoots": [".copilot", ".cache/copilot"],
      "isolation": {
        "env": {
          "COPILOT_HOME": "copilot"
        },
        "sharedRoots": [".copilot"],
        "denyReadable": [".copilot"]
      }
    },
    {
      "id": "qoder",
      "match": {
        "kind": "base",
        "values": ["qoder"]
      },
      "env": {
        "keys": ["QODER_PERSONAL_ACCESS_TOKEN", "QODER_CONFIG_DIR"]
      },
      "stateRoots": [".qoder"],
      "relocation": {
        "env": ["QODER_CONFIG_DIR"],
        "args": {
          "flags": ["--config-dir"],
          "pick": "last"
        },
        "default": ".qoder",
        "temp": "tmp"
      },
      "isolation": {
        "env": {
          "QODER_CONFIG_DIR": "qoder"
        },
        "sharedRoots": [".qoder"],
        "denyReadable": []
      },
      "programRoots": [".qoder/entry", ".qoder/bin"]
    },
    {
      "id": "goose",
      "match": {
        "kind": "base",
        "values": ["goose"]
      },
      "env": {
        "prefixes": ["GOOSE_"]
      },
      "stateRoots": [
        ".config/goose",
        ".local/share/goose",
        ".local/state/goose",
        "Library/Application Support/Block/goose"
      ],
      "isolation": {
        "env": {
          "GOOSE_PATH_ROOT": "goose"
        },
        "setEnv": {
          "GOOSE_DISABLE_KEYRING": "1"
        },
        "sharedRoots": [
          ".config/goose",
          ".local/share/goose",
          ".local/state/goose",
          "Library/Application Support/Block/goose"
        ],
        "denyReadable": [
          ".config/goose",
          ".local/share/goose",
          ".local/state/goose",
          "Library/Application Support/Block/goose"
        ]
      },
      "temp": {
        "home": ".local/state/goose/tmp",
        "isolated": {
          "env": "GOOSE_PATH_ROOT",
          "path": "state/tmp"
        }
      }
    },
    {
      "id": "grok",
      "match": {
        "kind": "base",
        "values": ["grok"]
      },
      "env": {
        "keys": [
          "XAI_API_KEY",
          "GROK_HOME",
          "GROK_DISABLE_AUTOUPDATER",
          "GROK_CHANGELOG_OFFLINE",
          "GROK_TELEMETRY_ENABLED",
          "GROK_TELEMETRY_TRACE_UPLOAD",
          "GROK_FEEDBACK_ENABLED"
        ],
        "privateBlank": ["XAI_API_KEY"]
      },
      "stateRoots": [".grok"],
      "relocation": {
        "env": ["GROK_HOME"],
        "default": ".grok",
        "temp": "tmp",
        "setEnv": {
          "GROK_DISABLE_AUTOUPDATER": "1",
          "GROK_CHANGELOG_OFFLINE": "1"
        }
      },
      "isolation": {
        "env": {
          "GROK_HOME": "grok"
        },
        "sharedRoots": [".grok"],
        "denyReadable": [".grok"]
      }
    },
    {
